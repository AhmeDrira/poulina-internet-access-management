# Port d'écoute de l'API NestJS
PORT=3000

# Chaîne de connexion MongoDB (locale ou docker-compose)
MONGODB_URI=mongodb://127.0.0.1:27017/poulina_internet_access

# Secret JWT — à remplacer par une valeur forte en production
JWT_SECRET=remplacez-par-une-cle-secrete-forte

# Durée de validité du token d'accès
JWT_EXPIRES_IN=8h

# Origine autorisée pour le CORS (URL du frontend)
CORS_ORIGIN=http://localhost:5173

# URL publique du frontend — sert à construire les liens d'activation de compte
APP_URL=http://localhost:5173

# Durée de validité (en heures) d'un lien d'activation / de réinitialisation
ACTIVATION_TOKEN_TTL_HOURS=48

# ---------------------------------------------------------------------------
# Authentification unique (OpenID Connect) — optionnelle
# Renseigner les trois premières variables active le bouton SSO sur la page de
# connexion. Compatible Microsoft Entra ID, Keycloak, Google Workspace...
# Aucun compte n'est créé automatiquement : l'email doit déjà exister.
# ---------------------------------------------------------------------------
SSO_ISSUER_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=http://localhost:3000/api/auth/sso/callback
SSO_SCOPES=openid email profile
SSO_BUTTON_LABEL=Se connecter avec le compte du groupe

# ---------------------------------------------------------------------------
# Assistance à la rédaction par IA (API Google Gemini) — optionnelle
# Sans clé, les boutons « Améliorer » et « Résumer » sont masqués.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
